{
  "name": "prompt-vault",
  "version": "1.15.1",
  "private": true,
  "type": "module",
  "description": "Back up ChatGPT, Claude, and Gemini chats to local Markdown, PDF, JSON, or HTML files.",
  "scripts": {
    "build": "vite build",
    "package": "node scripts/package.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "check:versions": "node scripts/check-version-sync.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/pdfmake": "^0.3.3",
    "eslint": "^10.14.0",
    "fontkit": "^2.0.4",
    "happy-dom": "^21.0.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "pdfmake": "^0.3.14"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
