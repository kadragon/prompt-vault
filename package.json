{
  "name": "prompt-vault",
  "version": "1.14.3",
  "private": true,
  "type": "module",
  "description": "Back up ChatGPT, Claude, and Gemini chats to local Markdown, PDF, JSON, or HTML files.",
  "scripts": {
    "build": "vite build",
    "package": "node scripts/package.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "check:versions": "node scripts/check-version-sync.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.3",
    "@types/pdfmake": "^0.3.3",
    "eslint": "^10.11.0",
    "fontkit": "^2.0.4",
    "happy-dom": "^20.14.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "pdfmake": "^0.3.11"
  }
}
